# Server-only Gemini key. Never prefix this with VITE_.
GEMINI_API_KEY=
# Optional; defaults to the model below.
GEMINI_MODEL=gemini-3.5-flash-lite

# Contact form SMTP (server-only; never use a VITE_ prefix).
# Gmail requires an App Password with 2-Step Verification enabled.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=omzala635@gmail.com
SMTP_PASS=
# Optional sender email for providers with a different SMTP username.
# Must be authorized by your SMTP provider; defaults to SMTP_USER.
SMTP_FROM=

# Arcade leaderboard (optional, independent of the chat)
MONGODB_URI=
MONGODB_DB=arcade
PILOT_COOKIE_SECRET=
